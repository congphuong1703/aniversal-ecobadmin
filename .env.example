# Server-only Supabase access. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production: at least 12 characters.
ADMIN_PASSWORD=

# Production: independent random values of at least 32 characters each.
ADMIN_SESSION_SECRET=
RSVP_VERIFICATION_SECRET=

# Local Playwright only. Never configure this variable in production or Vercel.
# E2E_REPOSITORY=memory
